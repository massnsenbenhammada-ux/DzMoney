{
  "name": "dzmoney",
  "version": "2.0.0",
  "private": true,
  "description": "DzMoney 2.0 — clean rebuild",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "prestart": "npm run build:monetag",
    "build:monetag": "esbuild public/monetag-adapter-entry.js --bundle --format=iife --platform=browser --outfile=public/monetag-adapter.bundle.js",
    "migrate": "node ./scripts/migrate.js",
    "reconcile:economy": "node ./scripts/reconcile-economy.js",
    "test:phase1": "node ./scripts/test-phase1.js",
    "test:economy-ledger": "node ./scripts/test-economy-ledger.js",
    "test:deposit": "node ./scripts/test-deposit.js",
    "test:phase2": "node ./scripts/test-phase2.js",
    "test:daily-checkin": "node ./scripts/test-daily-checkin.js",
    "test:daily-checkin-http": "node ./scripts/test-daily-checkin-http-boundary.js",
    "test:task-catalog": "node ./scripts/test-task-catalog.js",
    "test:task-execution": "node ./scripts/test-task-execution.js",
    "test:task-execution-active-attempt": "node ./scripts/test-task-execution-active-attempt.js",
    "test:task-execution-http": "node ./scripts/test-task-execution-http-boundary.js",
    "test:task-lifecycle": "node ./scripts/test-task-lifecycle.js",
    "test:task-click-http": "node ./scripts/test-task-click-http-boundary.js",
    "test:task-list-http": "node ./scripts/test-task-list-http.js",
    "test:task-list-frontend": "node ./scripts/test-task-list-frontend.js",
    "test:task-verification-config": "node ./scripts/test-task-verification-config.js",
    "test:task-trusted-verifier": "node ./scripts/test-task-trusted-verifier.js",
    "test:task-verification-postback": "node ./scripts/test-task-verification-postback.js",
    "test:task-advertisement-flow": "node ./scripts/test-task-advertisement-flow.js",
    "test:creator-campaign-contract": "node ./scripts/test-creator-campaign-contract.js",
    "test:creator-campaign-economics": "node ./scripts/test-creator-campaign-economics.js",
    "test:creator-campaign-review": "node ./scripts/test-creator-campaign-review.js",
    "test:creator-campaign-tax-refund": "node ./scripts/test-creator-campaign-tax-refund.js",
    "test:daily-task-check-for-update": "node ./scripts/test-daily-task-check-for-update.js",
    "test:ad-provider-system": "node ./scripts/test-ad-provider-system.js",
    "test:onclicka-provider": "node ./scripts/test-onclicka-provider.js",
    "test:monetag-postback": "node ./scripts/test-monetag-postback.js && node ./scripts/test-monetag-postback-http.js",
    "test:monetag-ymid": "node ./scripts/test-monetag-ymid-generation.js",
    "test:monetag-finalization": "node ./scripts/test-monetag-postback-finalization.js",
    "test:daily-checkin-monetag-contract": "node ./scripts/test-daily-checkin-monetag-contract.js",
    "test:monetag-sdk-readiness": "node ./scripts/test-monetag-sdk-readiness.js",
    "test:frontend": "node ./scripts/validate-frontend.js",
    "test:all": "npm run test:monetag-sdk-readiness && npm run test:frontend && npm run test:phase1 && npm run test:economy-ledger && npm run test:deposit && npm run test:phase2 && npm run test:daily-checkin && npm run test:daily-checkin-http && npm run test:task-catalog && npm run test:task-execution && npm run test:task-execution-active-attempt && npm run test:task-execution-http && npm run test:task-lifecycle && npm run test:task-click-http && npm run test:task-list-http && npm run test:task-list-frontend && npm run test:task-verification-config && npm run test:task-trusted-verifier && npm run test:task-verification-postback && npm run test:task-advertisement-flow && npm run test:creator-campaign-contract && npm run test:creator-campaign-economics && npm run test:creator-campaign-review && npm run test:creator-campaign-tax-refund && npm run test:daily-task-check-for-update && npm run test:ad-provider-system && npm run test:onclicka-provider && npm run test:monetag-postback && npm run test:monetag-ymid && npm run test:monetag-finalization && npm run test:daily-checkin-monetag-contract && npm run reconcile:economy"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "esbuild": "^0.28.1",
    "express": "^5.2.1",
    "pg": "^8.16.3"
  }
}
